        scene: "情境：自費 3 萬的檢測，窮人做不起。",
        options: [
          { key:"A", text:"沒錢就沒命（現實殘酷）", pts:{BI:-2},
            lead:"你選『不處理不平等』：流程最省事，但形象會被打爆。",
            bullets:["BI -2：被罵死要錢的醫院。","$ 0：醫院沒損失（但信任會損失）。"]},
          { key:"B", text:"團購殺價 + 補助（雙贏）", pts:{BI:2, CI:1, Money:-1},
            lead:"你選『把門檻降下來』：社會觀感與醫療效果都能提升。",
            bullets:["BI +2：社會責任落實，形象大加分。","CI +1：更多人做得起檢測，找到對的藥。","$ -1：少賺或貼補一點。"]},
          { key:"C", text:"醫院全額付（破產）", pts:{Money:-3},
            lead:"你選『聖母模式』：救得了人但救不了財報，走向破產危機。",
            bullets:["$ -3：資金耗盡，醫院倒閉 Game Over。"]}
        ]
      }
    ];

    // ====== 全域狀態 ======
    const score = { AI: 0, BI: 0, CI: 0, Money: 0 };
    const answers = new Map(); // index -> { optionKey, pts }
    let currentIndex = 0;

    // ====== DOM ======
    const sAI = document.getElementById("sAI");
    const sBI = document.getElementById("sBI");
    const sCI = document.getElementById("sCI");
    const sMoney = document.getElementById("sMoney");
    const progress = document.getElementById("progress");
    const qTitle = document.getElementById("qTitle");
    const qSub = document.getElementById("qSub");
    const optionsBox = document.getElementById("options");
    const picked = document.getElementById("picked");
    const delta = document.getElementById("delta");
    const analysisBox = document.getElementById("analysis");
    const analysisText = document.getElementById("analysisText");
    const analysisBullets = document.getElementById("analysisBullets");
    const prevBtn = document.getElementById("prev");
    const nextBtn = document.getElementById("next");
    const resetAllBtn = document.getElementById("resetAll");

    // ====== 工具 ======
    function renderScore() {
      sAI.textContent = score.AI;
      sBI.textContent = score.BI;
      sCI.textContent = score.CI;
      sMoney.textContent = score.Money;
    }

    function fmtDelta(pts) {
      const parts = [];
      const add = (k, v) => {
        if (!v) return;
        const sign = v > 0 ? "+" : "";
        parts.push(`${k}${sign}${v}`);
      };
      add("$", pts.Money || 0);
      add("BI", pts.BI || 0);
      add("CI", pts.CI || 0);
      add("AI", pts.AI || 0);
      return parts.length ? `（${parts.join("；")}）` : "（沒有獎勵點數）";
    }

    function clearAnalysis() {
      analysisText.textContent = "";
      analysisBullets.innerHTML = "";
      analysisBox.style.display = "none";
    }

    function showAnalysis(opt, bracket) {
      analysisText.textContent = `你選了 ${opt.key}. ${opt.text} ${bracket}。${opt.lead || ""}`;
      const bullets = (opt.bullets || []).map(t => `<li>${t}</li>`).join("");
      analysisBullets.innerHTML = bullets;
      analysisBox.style.display = "block";
      delta.textContent = bracket;
    }

    function applyPts(pts, mult=1) {
      score.AI += (pts.AI || 0) * mult;
      score.BI += (pts.BI || 0) * mult;
      score.CI += (pts.CI || 0) * mult;
      score.Money += (pts.Money || 0) * mult;
    }

    function setAnsweredUI(optionKey, bracket) {
      picked.textContent = `已作答：選項 ${optionKey}`;
      delta.textContent = bracket;
      nextBtn.disabled = false;
    }

    function setUnansweredUI() {
      picked.textContent = "尚未作答";
      delta.textContent = "尚未計分";
      nextBtn.disabled = true;
      clearAnalysis();
    }

    // ====== 渲染題目 ======
    function renderQuestion() {
      const q = QUESTIONS[currentIndex];
      progress.textContent = `第 ${currentIndex + 1} / ${QUESTIONS.length} 題`;
      qTitle.innerHTML = `<strong>${q.id}.</strong> ${q.title}`;
      qSub.textContent = q.scene ? q.scene : "";

      optionsBox.innerHTML = "";
      clearAnalysis();

      const existing = answers.get(currentIndex);

      q.options.forEach(opt => {
        const btn = document.createElement("button");
        btn.className = "opt";
        btn.type = "button";
        btn.textContent = `${opt.key}. ${opt.text}`;

        if (existing) {
          btn.disabled = true;
          if (existing.optionKey === opt.key) btn.style.borderColor = "#cfd6ff";
        }

        btn.addEventListener("click", () => onPickOption(opt));
        optionsBox.appendChild(btn);
      });

      prevBtn.disabled = currentIndex === 0;
      nextBtn.textContent = (currentIndex === QUESTIONS.length - 1) ? "完成" : "下一題";

      if (existing) {
        const pickedOpt = q.options.find(o => o.key === existing.optionKey);
        const bracket = fmtDelta(existing.pts);
        setAnsweredUI(existing.optionKey, bracket);
        showAnalysis(pickedOpt, bracket);
      } else {
        setUnansweredUI();
      }

      renderScore();
    }

    // ====== 作答 ======
    function onPickOption(opt) {
      if (answers.get(currentIndex)) return;

      const pts = opt.pts || {};
      applyPts(pts, 1);
      answers.set(currentIndex, { optionKey: opt.key, pts });

      // 鎖住所有選項
      optionsBox.querySelectorAll("button.opt").forEach(b => b.disabled = true);

      const bracket = fmtDelta(pts);
      setAnsweredUI(opt.key, bracket);
      showAnalysis(opt, bracket);
      renderScore();

      // 視覺強調
      const btns = Array.from(optionsBox.querySelectorAll("button.opt"));
      const chosen = btns.find(b => b.textContent.startsWith(opt.key + "."));
      if (chosen) chosen.style.borderColor = "#cfd6ff";
    }

    // ====== 導航 ======
    prevBtn.addEventListener("click", () => {
      if (currentIndex > 0) {
        currentIndex--;
        renderQuestion();
      }
    });

    nextBtn.addEventListener("click", () => {
      if (!answers.get(currentIndex)) return;

      if (currentIndex < QUESTIONS.length - 1) {
        currentIndex++;
        renderQuestion();
      } else {
        // 完成總結
        analysisBox.style.display = "block";
        analysisText.textContent = `✅ 你已完成全部 ${QUESTIONS.length} 題！最終積分如下：`;
        analysisBullets.innerHTML = `
          <li><strong>AI：</strong>${score.AI}</li>
          <li><strong>BI：</strong>${score.BI}</li>
          <li><strong>CI：</strong>${score.CI}</li>
          <li><strong>$：</strong>${score.Money}</li>
        `;
        picked.textContent = "全部完成";
        delta.textContent = "—";
        nextBtn.disabled = true;
      }
    });

    // ====== 重置 ======
    resetAllBtn.addEventListener("click", () => {
      answers.clear();
      score.AI = 0; score.BI = 0; score.CI = 0; score.Money = 0;
      currentIndex = 0;
      renderQuestion();
    });

    // 初始
    renderQuestion();
  </script>
</body>
</html>
